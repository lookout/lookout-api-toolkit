                "example": {
                  "url": "https://apps.apple.com/us/app/someapp/id123456789",
                  "error": "Not found"
                },
                "exampleSetFlag": true
              }
            }
          },
          "500": {
            "description": "Unexpected server side error",
            "content": {
              "application/json": {
                "schema": {
                  "required": ["url"],
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "exampleSetFlag": false
