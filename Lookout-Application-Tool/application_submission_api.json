                      "exampleSetFlag": false
                    },
                    "error": {
                      "type": "string",
                      "exampleSetFlag": false
                    }
                  },
                  "example": {
                    "url": "https://apps.apple.com/us/app/someapp/id123456789",
                    "error": "Unexpected server side error"
                  },
                  "exampleSetFlag": true
                },
                "example": {
                  "url": "https://apps.apple.com/us/app/someapp/id123456789",
                  "error": "Unexpected server side error"
                },
                "exampleSetFlag": true
              }
            }
          },
          "501": {
            "description": "App not supported",
            "content": {
              "application/json": {
                "schema": {
